# Postgres
DATABASE_URL=postgres://obuna:obuna@localhost:5432/obuna

# Telegram
BOT_TOKEN=123456:ABC
BOT_USERNAME=obunalar_uz_bot
# Mini App (apps/web) public URL, e.g. an https tunnel in development
WEBAPP_URL=https://localhost:5173
# Comma-separated Telegram user ids allowed to approve withdrawals
PLATFORM_ADMIN_IDS=

# API (Railway/Render set PORT themselves)
API_PORT=3000
# Public https address of the service. When set, the API registers the Telegram webhook,
# menu button, commands and bot description on every boot. Also used as WEBAPP_URL if that is empty.
PUBLIC_URL=
# Random strings: Telegram webhook secret and the secret for POST /internal/jobs (external cron)
WEBHOOK_SECRET=
JOBS_SECRET=
# AES-256 key for payout card numbers, required in production: openssl rand -base64 32
CARD_ENC_KEY=
# Renewals, reminders and expiry run in-process every N seconds (0 = only via /internal/jobs)
JOBS_INTERVAL_SEC=0
# Payout hold (hours) for channels younger than 14 days; the usual hold is HOLD_HOURS (24)
NEW_CHANNEL_HOLD_HOURS=168
# Built apps/web/dist served from the same origin (the Docker image sets this)
WEB_DIST=
# Platform commission in basis points (1000 = 10%)
COMMISSION_BPS=1000
# Allow ?devUser=<telegram id> instead of Telegram initData (never in production)
DEV_AUTH=true

# ATMOS (https://docs.atmos.uz). Leave ATMOS_MOCK=true until sandbox keys arrive.
ATMOS_MOCK=true
ATMOS_BASE_URL=https://apigw.atmos.uz
ATMOS_CONSUMER_KEY=
ATMOS_CONSUMER_SECRET=
ATMOS_STORE_ID=

# Production (docker-compose.prod.yml)
DOMAIN=obuna.example.uz
POSTGRES_PASSWORD=change-me
